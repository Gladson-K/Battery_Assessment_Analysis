            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"battery\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"battery_telemetry\" and r.device_id == \"$device\")\n  |> filter(fn: (r) => r._field == \"risk\")\n  |> last()",
