# Copy to .env and change every secret before production use.
INFLUX_USERNAME=battery
INFLUX_PASSWORD=change-me-influx-password
INFLUX_ORG=battery
INFLUX_BUCKET=battery
INFLUX_TOKEN=battery-dev-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Optional API key. Leave empty for a trusted lab network.
API_KEY=

# Serial gateway device mapping.
SERIAL_DEVICE=/dev/ttyUSB0
DIALOUT_GID=20

# Demo simulator (docker-compose --profile demo up -d).
SIM_DEVICE=bench-01
SIM_PROFILE=bench_6v

LOG_LEVEL=INFO
